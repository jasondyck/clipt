# Maintainer: The clipt contributors
pkgname=clipt
pkgver=0.2.0
pkgrel=1
pkgdesc="Fast, lightweight screenshot and screen-recording tool for Wayland and X11"
arch=('x86_64' 'aarch64')
url="https://github.com/jasondyck/clipt"
license=('MIT OR Apache-2.0')
# fontconfig: fc-match is run (not linked) to find the UI font
depends=('glibc' 'libgcc' 'libxkbcommon' 'fontconfig')
options=('!debug')  # release builds are stripped
makedepends=('cargo')
optdepends=('xdg-desktop-portal: capture on GNOME'
            'ffmpeg: screen recording'
            'libpipewire: screen recording on KDE and GNOME'
            'noto-fonts: default UI font')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('706047c1f9ac0bd3ffbb51cdcdf276c3df49a87c8fc6cccafa5f947a80451659')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/clipt -t "$pkgdir/usr/bin/"
  install -Dm644 data/clipt.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 data/clipt.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 data/clipt.1 -t "$pkgdir/usr/share/man/man1/"
  install -Dm644 data/completions/clipt.bash "$pkgdir/usr/share/bash-completion/completions/clipt"
  install -Dm644 data/completions/_clipt -t "$pkgdir/usr/share/zsh/site-functions/"
  install -Dm644 data/completions/clipt.fish -t "$pkgdir/usr/share/fish/vendor_completions.d/"
  install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
