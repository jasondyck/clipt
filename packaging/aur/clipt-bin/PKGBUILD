# Maintainer: The clipt contributors
pkgname=clipt-bin
_pkgname=clipt
pkgver=0.1.1
pkgrel=1
pkgdesc="Fast, lightweight screenshot tool for Wayland and X11 (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/jasondyck/clipt"
license=('MIT OR Apache-2.0')
# fontconfig: fc-match is run (not linked) to find the UI font
depends=('glibc' 'libgcc' 'libxkbcommon' 'fontconfig')
options=('!debug')  # release builds are stripped
provides=("$_pkgname")
conflicts=("$_pkgname")
source_x86_64=("$url/releases/download/v$pkgver/$_pkgname-v$pkgver-x86_64-linux.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/$_pkgname-v$pkgver-aarch64-linux.tar.gz")
sha256sums_x86_64=('fd7b277090f55b4f23b7d9395f4a8a5f435eddad2ba89aefce28336c0c035717')
sha256sums_aarch64=('6bcdeee034a380ffc8ed45bd836df09660e23f597838d5b6818fd5a6754091af')

package() {
  cd "$_pkgname-v$pkgver-$CARCH-linux"
  install -Dm755 clipt -t "$pkgdir/usr/bin/"
  install -Dm644 clipt.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 clipt.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 clipt.1 -t "$pkgdir/usr/share/man/man1/"
  install -Dm644 clipt.bash "$pkgdir/usr/share/bash-completion/completions/clipt"
  install -Dm644 _clipt -t "$pkgdir/usr/share/zsh/site-functions/"
  install -Dm644 clipt.fish -t "$pkgdir/usr/share/fish/vendor_completions.d/"
  install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$_pkgname/"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$_pkgname/"
}
